{
  "name": "fighters",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Fighters — real-rig 3D scrolling beat-em-up with deterministic combat",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:engine": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "animation:build": "node scripts/build-quaternius-animations.mjs",
    "animation:verify": "node scripts/check-quaternius-models.mjs public/models"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "@types/three": "^0.186.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
