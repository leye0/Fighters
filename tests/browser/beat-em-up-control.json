{
  "url": "http://127.0.0.1:4173/site/beat-em-up.html?qa=1",
  "steps": [
    {
      "action": "assert",
      "expression": "window.__fightersBeatReady === true && window.__fightersBeatHero?.facing === 1"
    },
    {
      "action": "wait",
      "ms": 550
    },
    {
      "action": "logExpr",
      "expression": "JSON.stringify(window.__fightersBeatActorBounds)"
    },
    {
      "action": "assert",
      "expression": "Array.isArray(window.__fightersBeatActorBounds) && window.__fightersBeatActorBounds.length === 3 && window.__fightersBeatActorBounds.every(a => a.visible && a.skinnedMeshes > 0 && a.height > 1 && a.height < 2.2 && Math.abs(a.centerNdcX) < 1 && Math.abs(a.centerNdcY) < 1)"
    },
    {
      "action": "screenshot",
      "name": "01-idle"
    },
    {
      "action": "keyDown",
      "key": "ArrowRight"
    },
    {
      "action": "wait",
      "ms": 1300
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.facing === 1 && (window.__qaRightX=window.__fightersBeatHero.xMm) > -10700"
    },
    {
      "action": "logExpr",
      "expression": "JSON.stringify(window.__fightersBeatActorBounds)"
    },
    {
      "action": "screenshot",
      "name": "02-walk-right"
    },
    {
      "action": "keyUp",
      "key": "ArrowRight"
    },
    {
      "action": "keyDown",
      "key": "ArrowLeft"
    },
    {
      "action": "wait",
      "ms": 1300
    },
    {
      "action": "logExpr",
      "expression": "JSON.stringify({hero:window.__fightersBeatHero,rightX:window.__qaRightX,bounds:window.__fightersBeatActorBounds})"
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.facing === -1 && window.__fightersBeatHero.xMm < window.__qaRightX - 100"
    },
    {
      "action": "screenshot",
      "name": "03-reversed-left"
    },
    {
      "action": "keyUp",
      "key": "ArrowLeft"
    },
    {
      "action": "keyDown",
      "key": "Space"
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
      "action": "keyUp",
      "key": "Space"
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.heightMm > 100 && window.__fightersBeatHero.supportingPlatformId === null"
    },
    {
      "action": "screenshot",
      "name": "04-airborne-jump"
    },
    {
      "action": "wait",
      "ms": 1450
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.supportingPlatformId === 'ground' && window.__fightersBeatHero.heightMm === 0"
    },
    {
      "action": "screenshot",
      "name": "05-landed"
    }
  ]
}
