{
  "url": "http://127.0.0.1:4173/beat-em-up.html?qa=1",
  "steps": [
    {
      "action": "assert",
      "expression": "document.querySelector('#beat-diagnostics').hidden===true && document.querySelector('#beat-debug-toggle').getAttribute('aria-expanded')==='false'"
    },
    {
      "action": "click",
      "selector": "#beat-debug-toggle"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('#beat-diagnostics').hidden===false && document.querySelector('#beat-debug-toggle').getAttribute('aria-expanded')==='true'"
    },
    {
      "action": "click",
      "selector": "#beat-debug-toggle"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('#beat-diagnostics').hidden===true && document.querySelector('#beat-debug-toggle').textContent==='Stats'"
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatReady === true && window.__fightersBeatHero?.facing === 1"
    },
    {
      "action": "wait",
      "ms": 450
    },
    {
      "action": "logExpr",
      "expression": "JSON.stringify(window.__fightersBeatActorBounds)"
    },
    {
      "action": "assert",
      "expression": "Array.isArray(window.__fightersBeatActorBounds) && window.__fightersBeatActorBounds.length === 3 && window.__fightersBeatActorBounds.every(a => a.visible && a.skinnedMeshes > 0 && a.height > 1 && a.height < 2.2 && Math.abs(a.centerNdcX) < 1 && Math.abs(a.centerNdcY) < 1)"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=true,true)"
    },
    {
      "action": "screenshot",
      "name": "01-idle"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=false,true)"
    },
    {
      "action": "keyDown",
      "key": "ArrowRight"
    },
    {
      "action": "wait",
      "ms": 950
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.facing===1 && window.__fightersBeatHero.xMm>-10700"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=true, window.__qaRightX=window.__fightersBeatHero.xMm, true)"
    },
    {
      "action": "screenshot",
      "name": "02-walk-right"
    },
    {
      "action": "keyUp",
      "key": "ArrowRight"
    },
    {
      "action": "keyDown",
      "key": "ArrowLeft"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=false,true)"
    },
    {
      "action": "wait",
      "ms": 950
    },
    {
      "action": "logExpr",
      "expression": "JSON.stringify({hero:window.__fightersBeatHero,rightX:window.__qaRightX,bounds:window.__fightersBeatActorBounds})"
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.facing===-1 && window.__fightersBeatHero.xMm < window.__qaRightX-100"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=true,true)"
    },
    {
      "action": "screenshot",
      "name": "03-reversed-left"
    },
    {
      "action": "keyUp",
      "key": "ArrowLeft"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=false,true)"
    },
    {
      "action": "keyDown",
      "key": "Space"
    },
    {
      "action": "wait",
      "ms": 280
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=true,true)"
    },
    {
      "action": "keyUp",
      "key": "Space"
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.heightMm>100 && window.__fightersBeatHero.supportingPlatformId===null"
    },
    {
      "action": "screenshot",
      "name": "04-airborne-jump"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=false,true)"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatHero?.heightMm===0 && window.__fightersBeatHero.supportingPlatformId==='ground'"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=true,true)"
    },
    {
      "action": "screenshot",
      "name": "05-landed"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=false,true)"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreezeAtAttackAge=14,true)"
    },
    {
      "action": "keyDown",
      "key": "KeyF"
    },
    {
      "action": "wait",
      "ms": 160
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatFreeze===true && window.__fightersBeatHeroMotion==='UAL1_Punch_Jab'"
    },
    {
      "action": "screenshot",
      "name": "06-quaternius-jab"
    },
    {
      "action": "keyUp",
      "key": "KeyF"
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreeze=false,true)"
    },
    {
      "action": "wait",
      "ms": 1800
    },
    {
      "action": "assert",
      "expression": "(window.__fightersBeatFreezeAtAttackAge=21,true)"
    },
    {
      "action": "keyDown",
      "key": "KeyG"
    },
    {
      "action": "wait",
      "ms": 160
    },
    {
      "action": "assert",
      "expression": "window.__fightersBeatFreeze===true && window.__fightersBeatHeroMotion==='UAL1_Punch_Cross'"
    },
    {
      "action": "screenshot",
      "name": "07-quaternius-cross"
    }
  ]
}
